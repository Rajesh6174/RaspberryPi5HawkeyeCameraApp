[Unit]
Description=Pi Camera MJPEG live stream (port 8000)
After=network.target

[Service]
EnvironmentFile=-%h/.config/camera-stream/gdrive.env
EnvironmentFile=-%h/.config/camera-stream/location.env
EnvironmentFile=-%h/.config/camera-stream/performance.env
ExecStart=/usr/bin/python3 %h/.local/share/camera-stream/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
