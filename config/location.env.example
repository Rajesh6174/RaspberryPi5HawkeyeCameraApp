# Copy this file to location.env (same directory) and fill in your real
# coordinates. Not required - if absent, the weather overlay just shows
# conditions for lat/lon 0,0 (Gulf of Guinea) instead of your location.
# chmod 600 location.env afterward, same as the other config files.
#
# Find your lat/lon: https://www.latlong.net/ (search your city or zip)

WEATHER_LAT=0
WEATHER_LON=0
