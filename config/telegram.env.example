# Copy this file to telegram.env (same directory) and fill in real values.
# chmod 600 telegram.env afterward — it holds a bot token.

TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
TELEGRAM_CHAT_ID=123456789

# Optional tuning (defaults shown)
GARAGE_DIFF_THRESHOLD=18
GARAGE_CHECK_INTERVAL=20
GARAGE_ALERT_ON_CLOSE=false
