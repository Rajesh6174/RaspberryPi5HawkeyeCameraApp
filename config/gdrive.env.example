# Copy this file to gdrive.env (same directory) and fill in real values.
# chmod 600 gdrive.env afterward — it holds OAuth secrets.
#
# GDRIVE_CLIENT_ID / GDRIVE_CLIENT_SECRET come from Google Cloud Console ->
# APIs & Services -> Credentials -> Create OAuth client -> type "TVs and
# Limited Input devices". GDRIVE_REFRESH_TOKEN is filled in automatically by
# setup_gdrive.py after you run it once and approve on your phone/laptop.

GDRIVE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GDRIVE_CLIENT_SECRET=your-client-secret
