# Copy this file to performance.env (same directory) to override resolution,
# bitrate, and buffer settings. Optional - every value below is commented out
# and shows the built-in default (tuned for Pi 4/5). Uncomment and edit only
# the lines you want to change.
#
# For a Raspberry Pi Zero 2 W (or any 512MB-1GB RAM board), uncomment the
# "Low-power board" block instead - see the "Low-Power Boards" section of
# SETUP.md for the reasoning behind these numbers.

# --- Defaults (Pi 4/5) ---
# CAMERA_MAIN_WIDTH=3840
# CAMERA_MAIN_HEIGHT=2160
# CAMERA_LORES_WIDTH=1280
# CAMERA_LORES_HEIGHT=720
# CAMERA_BUFFER_COUNT=6
# RECORDING_BITRATE=20000000
# CONTINUOUS_BITRATE=2000000
# CONTINUOUS_SEGMENT_SECONDS=600
# CONTINUOUS_RETENTION_SECONDS=10800
# CONTINUOUS_DEFAULT_ENABLED=1

# --- Low-power board (e.g. Raspberry Pi Zero 2 W) ---
# CAMERA_MAIN_WIDTH=1280
# CAMERA_MAIN_HEIGHT=720
# CAMERA_LORES_WIDTH=640
# CAMERA_LORES_HEIGHT=360
# CAMERA_BUFFER_COUNT=3
# RECORDING_BITRATE=4000000
# CONTINUOUS_BITRATE=800000
# CONTINUOUS_SEGMENT_SECONDS=600
# CONTINUOUS_RETENTION_SECONDS=3600
# CONTINUOUS_DEFAULT_ENABLED=0
